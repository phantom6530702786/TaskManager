<Window x:Class="TaskManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TaskManager"
        mc:Ignorable="d"
        Title="MainWindow" Height="508" Width="1031">
    <Grid>
        <ListView x:Name="listview_ListTask" d:ItemsSource="{d:SampleData ItemCount=5}" Margin="10,260,10,10">
            <ListView.View>
                <GridView AllowsColumnReorder="true">
                    <GridViewColumn Header="Task" DisplayMemberBinding="{Binding Title}" Width="100"/>
                    <!--<GridViewColumn Header="Loại GD" DisplayMemberBinding="{Binding loaiGD}" Width="100"/>
                    <GridViewColumn Header="Giá" DisplayMemberBinding="{Binding gia}" Width="100"/>
                    <GridViewColumn Header="Số lượng" DisplayMemberBinding="{Binding soluong}" Width="100"/>
                    <GridViewColumn Header="Phí GD" DisplayMemberBinding="{Binding phiGd}" Width="100"/>
                    <GridViewColumn Header="Tổng giá trị" DisplayMemberBinding="{Binding tongGt}" Width="100"/>
                    <GridViewColumn Header="Ngày GD" DisplayMemberBinding="{Binding ngayGd}" Width="100"/>-->
                </GridView>
            </ListView.View>
        </ListView>
        <GroupBox Header="" Margin="10,10,10,0" Height="236" VerticalAlignment="Top">
            <Grid Height="201" Margin="10,0,7,0" VerticalAlignment="Top">
                <Label Content="Title" HorizontalAlignment="Left" Margin="13,8,0,0" VerticalAlignment="Top" Width="35"/>
                <TextBox x:Name="tb_title" Height="25" Margin="59,10,8,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" RenderTransformOrigin="0.5,0.5">
                    <TextBox.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform/>
                            <SkewTransform/>
                            <RotateTransform Angle="-0.005"/>
                            <TranslateTransform/>
                        </TransformGroup>
                    </TextBox.RenderTransform>
                </TextBox>
                <Button x:Name="bt_SaveTask" Content="Save" Margin="0,169,30,0" VerticalAlignment="Top" Height="22" HorizontalAlignment="Right" Width="78" Click="bt_SaveTask_Click"/>
            </Grid>
        </GroupBox>

    </Grid>
</Window>
